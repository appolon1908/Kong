# Non-secret template for the root-owned runtime env file consumed by
# compose.kong.yaml (CODESTRA_RUNTIME_ENV, e.g.
# /etc/codestra/secrets/kong/runtime.env, mode 0600, owned by root).
#
# Only the variable NAMES belong in Git. Never commit the values: see
# SECURITY.md. This file exists because the two secrets below are read by the
# declarative config through {vault://env/...} references, and the env vault
# resolves references against real environment variables. The KONG_*_FILE
# mechanism in the official entrypoint covers only genuine Kong options, so it
# cannot supply these two.

# Referenced by deploy/kong/scope-policy.lua as
# {vault://env/kong-control-plane-gateway-secret}. The env vault uppercases the
# resource name and maps '-' to '_'. If this is empty or absent, the policy
# returns 503 gateway_identity_unavailable and no request reaches an upstream.
# This is the shared secret Middleware uses to prove a request traversed Kong;
# it is not an application credential and must be rotated with Middleware.
KONG_CONTROL_PLANE_GATEWAY_SECRET=REQUIRED_ROTATED_GATEWAY_SECRET

# Referenced by the control-plane rate-limiting plugin as
# {vault://env/kong-rate-limit-redis-password}. rate-limiting runs with
# fault_tolerant false, so an unreachable or unauthenticated Redis fails closed
# rather than silently disabling the limit.
KONG_RATE_LIMIT_REDIS_PASSWORD=REQUIRED_REDIS_PASSWORD

# Referenced by every openid-connect authority (deploy/kong/control-plane.yml,
# kong/plugins/oidc/keycloak.yml and the calling/moneybee renderers) as
# {vault://env/kong-oidc-cache-tokens-salt}. decK >= 1.59 requires a stable
# cache_tokens_salt; without this variable the env vault cannot resolve the
# reference and the declarative config is rejected at load. One high-entropy
# value, identical across every node of the same deployment, never printed,
# never regenerated during promotion (docs/DECK-OIDC-COMPATIBILITY.md).
KONG_OIDC_CACHE_TOKENS_SALT=REQUIRED_STABLE_HIGH_ENTROPY_SALT

# ---------------------------------------------------------------------------
# Values supplied to compose itself rather than to Kong. Listed here so a single
# reviewed file covers the whole node; they are not secrets.
# ---------------------------------------------------------------------------

# Immutable digest from the protected release-evidence workflow artifact
# (kong-image.txt). A floating tag is not accepted.
KONG_IMAGE_DIGEST=sha256:REQUIRED_EXACT_RELEASE_DIGEST

# Hybrid DP has no PostgreSQL authority. Cluster identity is mounted as
# cluster_ca, dp_cert and dp_key by compose.kong.yaml.
# No runtime env value authorizes apply; the separate gate remains closed.

# Exact source the Caddy edge connects from. get_forwarded_scheme() only honours
# X-Forwarded-Proto from a trusted peer; leaving this unset makes the
# control-plane policy reject every request with 426. There is no safe default,
# and 0.0.0.0/0 would let any client assert https.
KONG_TRUSTED_IPS=REQUIRED_EXACT_CADDY_SOURCE_CIDR
