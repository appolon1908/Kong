{
  "$id": "urn:codestra:gateway-integration:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "codestra.gateway/v1"
    },
    "kind": {
      "const": "GatewayIntegration"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "criticality": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "dataClassification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "environment": {
          "enum": [
            "development",
            "staging",
            "production"
          ]
        },
        "id": {
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]{1,62}$",
          "type": "string"
        },
        "owner": {
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]{1,62}$",
          "type": "string"
        },
        "securityOwner": {
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]{1,62}$",
          "type": "string"
        },
        "system": {
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]{1,62}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "system",
        "owner",
        "securityOwner",
        "criticality",
        "dataClassification",
        "environment"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "authentication": {
          "additionalProperties": false,
          "properties": {
            "audience": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
              "type": "string"
            },
            "authorizedParties": {
              "items": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
                "type": "string"
              },
              "maxItems": 64,
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "caCertificateIds": {
              "items": {
                "maxLength": 36,
                "minLength": 1,
                "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
                "type": "string"
              },
              "maxItems": 64,
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "issuer": {
              "enum": [
                "https://auth.codestra.co/realms/codestra",
                "https://auth-staging.codestra.co/realms/codestra"
              ]
            },
            "keyId": {
              "maxLength": 63,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9-]{1,62}$",
              "type": "string"
            },
            "legacySunset": {
              "format": "date",
              "type": "string"
            },
            "roles": {
              "items": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
                "type": "string"
              },
              "maxItems": 64,
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "scopes": {
              "items": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
                "type": "string"
              },
              "maxItems": 64,
              "minItems": 0,
              "type": "array",
              "uniqueItems": true
            },
            "secretRef": {
              "pattern": "^\\{vault://env/kong-webhook-[a-z][a-z0-9-]{1,96}\\}$",
              "type": "string"
            },
            "template": {
              "enum": [
                "public-oidc-api",
                "internal-service-jwt",
                "private-mtls-api",
                "signed-webhook",
                "websocket-api",
                "public-health",
                "legacy-api-key"
              ]
            },
            "tenantClaim": {
              "enum": [
                "tenant_id",
                "tenant",
                "org_id"
              ]
            }
          },
          "required": [
            "template"
          ],
          "type": "object"
        },
        "exposure": {
          "enum": [
            "public",
            "private"
          ]
        },
        "host": {
          "maxLength": 253,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$",
          "type": "string"
        },
        "operations": {
          "additionalProperties": false,
          "properties": {
            "rollbackMaximumMinutes": {
              "maximum": 60,
              "minimum": 1,
              "type": "integer"
            },
            "runbook": {
              "maxLength": 180,
              "minLength": 1,
              "pattern": "^operations/runbooks/[a-z0-9-]+\\.md$",
              "type": "string"
            }
          },
          "required": [
            "runbook",
            "rollbackMaximumMinutes"
          ],
          "type": "object"
        },
        "policies": {
          "additionalProperties": false,
          "properties": {
            "corsOrigins": {
              "items": {
                "maxLength": 253,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 64,
              "minItems": 0,
              "type": "array",
              "uniqueItems": true
            },
            "redisHost": {
              "maxLength": 253,
              "minLength": 1,
              "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$",
              "type": "string"
            },
            "redisPasswordRef": {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^\\{vault://env/[a-z][a-z0-9-]{1,126}\\}$",
              "type": "string"
            },
            "requireCorrelationId": {
              "type": "boolean"
            },
            "sourceAllowlist": {
              "items": {
                "maxLength": 64,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 64,
              "minItems": 0,
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "sourceAllowlist",
            "corsOrigins",
            "requireCorrelationId",
            "redisHost",
            "redisPasswordRef"
          ],
          "type": "object"
        },
        "release": {
          "additionalProperties": false,
          "properties": {
            "immutableImagesRequired": {
              "const": true
            },
            "runtimeApplyAuthorized": {
              "const": false
            },
            "signedSourceRequired": {
              "const": true
            }
          },
          "required": [
            "runtimeApplyAuthorized",
            "signedSourceRequired",
            "immutableImagesRequired"
          ],
          "type": "object"
        },
        "routes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "maxLength": 63,
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9-]{1,62}$",
                "type": "string"
              },
              "match": {
                "enum": [
                  "exact",
                  "prefix"
                ]
              },
              "maxBodyBytes": {
                "maximum": 1048576,
                "minimum": 1,
                "type": "integer"
              },
              "methods": {
                "items": {
                  "enum": [
                    "GET",
                    "HEAD",
                    "POST",
                    "PUT",
                    "PATCH",
                    "DELETE",
                    "OPTIONS"
                  ]
                },
                "maxItems": 7,
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "operationIds": {
                "items": {
                  "maxLength": 63,
                  "minLength": 1,
                  "pattern": "^[a-z][a-z0-9-]{1,62}$",
                  "type": "string"
                },
                "maxItems": 7,
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "path": {
                "maxLength": 256,
                "minLength": 1,
                "pattern": "^/[A-Za-z0-9_./{}-]*$",
                "type": "string"
              },
              "ratePerMinute": {
                "maximum": 10000,
                "minimum": 1,
                "type": "integer"
              },
              "retrySafe": {
                "description": "Explicit reviewed authorization for retries of effects, in addition to Middleware idempotency authority.",
                "type": "boolean"
              },
              "scopes": {
                "items": {
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
                  "type": "string"
                },
                "maxItems": 64,
                "minItems": 0,
                "type": "array",
                "uniqueItems": true
              },
              "trafficPolicy": {
                "additionalProperties": false,
                "properties": {
                  "burstPerSecond": {
                    "maximum": 1000000,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "maxConcurrentPerWorker": {
                    "maximum": 10000,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "tenantQuotaPerMinute": {
                    "maximum": 1000000,
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "type": "object"
              }
            },
            "required": [
              "id",
              "path",
              "match",
              "methods",
              "operationIds",
              "scopes",
              "maxBodyBytes",
              "ratePerMinute"
            ],
            "type": "object"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "upstream": {
          "additionalProperties": false,
          "properties": {
            "dnsName": {
              "maxLength": 253,
              "minLength": 1,
              "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$",
              "type": "string"
            },
            "healthPath": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^/[A-Za-z0-9_./{}-]*$",
              "type": "string"
            },
            "idempotencyAuthority": {
              "enum": [
                "none",
                "Middleware"
              ]
            },
            "port": {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            "protocol": {
              "enum": [
                "http",
                "https"
              ]
            },
            "readinessPath": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^/[A-Za-z0-9_./{}-]*$",
              "type": "string"
            },
            "retries": {
              "maximum": 3,
              "minimum": 0,
              "type": "integer"
            },
            "service": {
              "maxLength": 63,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9-]{1,62}$",
              "type": "string"
            },
            "timeouts": {
              "additionalProperties": false,
              "properties": {
                "connectMs": {
                  "maximum": 10000,
                  "minimum": 1,
                  "type": "integer"
                },
                "readMs": {
                  "maximum": 60000,
                  "minimum": 1,
                  "type": "integer"
                },
                "writeMs": {
                  "maximum": 60000,
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "connectMs",
                "readMs",
                "writeMs"
              ],
              "type": "object"
            },
            "tlsServerName": {
              "maxLength": 253,
              "minLength": 1,
              "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$",
              "type": "string"
            }
          },
          "required": [
            "service",
            "dnsName",
            "protocol",
            "port",
            "healthPath",
            "readinessPath",
            "timeouts",
            "retries",
            "idempotencyAuthority"
          ],
          "type": "object"
        }
      },
      "required": [
        "exposure",
        "host",
        "upstream",
        "routes",
        "authentication",
        "policies",
        "release",
        "operations"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "type": "object"
}
